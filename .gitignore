# Los CSV de inventario y derivados no se versionan (100+ MB cada uno)
*.csv

# Logs y archivos de trabajo de scripts/correr_tanda.py
/logs/

# Credenciales del bot de descarga (usar .env.example como plantilla)
.env

# Artefactos de compilacion
*.aux
*.log
__pycache__/

# Cache del pipeline de enriquecimiento externo (datasets IMDb + resultados por titulo,
# taxonomias IAB descargadas), EXCEPTO la tabla de semantica por app, que es curada a
# mano y si se versiona
cache-enriquecimiento/*
!cache-enriquecimiento/semantica_apps.csv

# Las muestras para revision manual de la validacion de categorias son chicas y si se
# versionan (el CSV fila a fila queda en la raiz, cubierto por *.csv)
!reportes/*/validacion-*-muestra-*.csv
!reportes/*/recursos/validacion-*-muestra-*.csv
# La lista de valores marcados incorrectos en la revision manual (chica; evidencia de la precision)
!reportes/*/recursos/revision-incorrectos.csv

# Reporte interno (material de trabajo, no para lectores externos)
reportes/old_reports/08-enriquecimiento-externo/reporte-enriquecimiento-externo.md
reportes/old_reports/11-enriquecimiento-externo-v16/reporte-enriquecimiento-externo.md
reportes/old_reports/13-enriquecimiento-externo-v17/reporte-enriquecimiento-externo.md

# Material de trabajo suelto en la raiz (no se versiona)
/resumen-ejecutivo.pdf
/visualTabla.png
