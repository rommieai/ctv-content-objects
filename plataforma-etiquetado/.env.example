# Copiar a .env (no se versiona). Cuenta de PubMatic Media Console con la que el bot crea los deals.
PUBMATIC_USUARIO=
PUBMATIC_CLAVE=
# DSP y buyer con los que se crean (texto tal como aparece en PubMatic)
PUBMATIC_DSP=DV360
PUBMATIC_BUYER=Ariadna Co DBM
# 1 = el bot recorre el asistente y se detiene en el resumen, sin crear el deal
DEALS_ENSAYO=0
# Pestaña AI Deals: llave del modelo que lee el brief de la campaña (sin ninguna la pestaña avisa y no arma nada).
# Sirve una de las dos; si están las dos se usa Claude, salvo AI_DEALS_PROVEEDOR=groq
ANTHROPIC_API_KEY=
# Groq (console.groq.com, tiene capa gratuita): modelo openai/gpt-oss-120b; la de respaldo entra si la principal se queda sin cupo
GROQ_API_KEY=
GROQ_API_KEY_BACKUP=
